# Domain Configuration for Multi-App VPS Setup
# Copy and customize this for your domain deployment

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================
# Your domain name (without protocol)
DOMAIN=retroos.yourdomain.com

# Alternative domains (if you have multiple)
# DOMAIN_ALT=retro.yourdomain.com,vintage.yourdomain.com

# =============================================================================
# TRAEFIK CONFIGURATION
# =============================================================================
# Your email for Let's Encrypt SSL certificates
TRAEFIK_EMAIL=your-email@example.com

# Traefik dashboard domain (optional)
TRAEFIK_DASHBOARD_DOMAIN=traefik.yourdomain.com

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================
# MongoDB connection (internal Docker network)
MONGO_URL=mongodb://mongodb:27017
DB_NAME=retroos

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Backend URL for frontend (should match your domain)
REACT_APP_BACKEND_URL=https://retroos.yourdomain.com

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Enable secure cookies in production
SECURE_COOKIES=true

# Session secret (generate a random string)
SESSION_SECRET=your_random_session_secret_here_make_it_long_and_complex

# =============================================================================
# COMPOSE SETTINGS
# =============================================================================
# Docker compose project name (avoid conflicts with other apps)
COMPOSE_PROJECT_NAME=retroos