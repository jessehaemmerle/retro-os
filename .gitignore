# Build-Artefakte
build/
*.o
*.d
*.elf
*.bin
*.iso
*.img

# Extern bezogenes - der Bootloader wird beim Bauen geholt.
#
# Die Symbolvorlagen und die Schriften liegen dagegen im Baum: Sie sind
# klein, stehen unter freien Lizenzen, und ohne sie liessen sich
# icon_data.c und font_data.c nicht neu erzeugen. Deshalb wird hier der
# Inhalt ausgeschlossen, nicht der Ordner - sonst kaeme die Ausnahme gar
# nicht mehr zum Zug.
third_party/*
!third_party/lucide/
!third_party/fonts/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Testprogramm der Wirtsmaschine
tests/krypto-test
tests/bild-test
tests/js-test
tests/baum-test
tests/tabellen-test
tests/schreiben-test
tests/rechte-test
