# RetroOS Environment Configuration Template
# Copy this file to .env and customize for your deployment

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# Backend URL that frontend will use to make API calls
# For local development: http://localhost:8001
# For production with domain: https://yourdomain.com
REACT_APP_BACKEND_URL=http://localhost:8001

# React development server configuration
WDS_SOCKET_PORT=443

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================
# MongoDB connection string
# For Docker setup: mongodb://mongodb:27017
# For external MongoDB: mongodb://username:password@host:port
MONGO_URL=mongodb://mongodb:27017

# Database name
DB_NAME=retroos

# =============================================================================
# MONGODB CONFIGURATION (Optional)
# =============================================================================
# Uncomment and configure if you want authentication for MongoDB
# MONGO_INITDB_ROOT_USERNAME=admin
# MONGO_INITDB_ROOT_PASSWORD=your_secure_password
# MONGO_INITDB_DATABASE=retroos

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# Set to 'production' for production builds
NODE_ENV=development

# Security settings for production
# SECURE_COOKIES=true
# SESSION_SECRET=your_random_session_secret_here

# =============================================================================
# DOCKER SETTINGS
# =============================================================================
# Docker compose project name
COMPOSE_PROJECT_NAME=retroos

# External ports (what ports will be exposed on your host)
NGINX_PORT=80
FRONTEND_PORT=3000
BACKEND_PORT=8001
MONGODB_PORT=27017